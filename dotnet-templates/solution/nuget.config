<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!--
      Package mode only. Add the Core feed here and NOT before it exists —
      a source pointing at a missing folder fails restore for the whole
      solution, not just for the packages it was meant to serve.

      <add key="core" value="..\Packages" />
    -->
  </packageSources>
</configuration>
